<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ni.edu.uam.hibernateorm.controller.LoginController" prefWidth="820" prefHeight="520" stylesheets="@ambar.css">
 <top><HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #fffefa; -fx-padding: 20 38; -fx-border-color: transparent transparent #e5ddd1 transparent;"><Label text="●" style="-fx-text-fill: #ad5d37; -fx-font-size: 19px;"/><Label text="ÁMBAR" style="-fx-font-size: 17px; -fx-font-weight: bold;"/><Region HBox.hgrow="ALWAYS"/><Label text="GESTIÓN DE PERSONAS" styleClass="eyebrow"/></HBox></top>
 <center><HBox alignment="CENTER" spacing="65" style="-fx-padding: 38 55;">
  <VBox spacing="18" prefWidth="300" alignment="CENTER_LEFT"><Label text="TU ESPACIO DE TRABAJO" styleClass="eyebrow"/><Label text="Las personas,&#10;en primer lugar." styleClass="title" wrapText="true"/><Label text="Un lugar sencillo para organizar los perfiles y las cuentas de tu equipo." wrapText="true" styleClass="subtitle"/><Region prefHeight="20"/><Label text="01  /  DIRECTORIO" style="-fx-text-fill: #b7a594; -fx-font-size: 11px; -fx-font-weight: bold;"/></VBox>
  <VBox spacing="17" prefWidth="335" styleClass="card" style="-fx-padding: 28;"><Label text="Acceder" style="-fx-font-size: 23px; -fx-font-weight: bold;"/><Label text="Introduce tus datos para continuar." styleClass="subtitle"/><VBox spacing="6"><Label text="Usuario" styleClass="field-label"/><TextField fx:id="txtUsuario" promptText="Tu nombre de usuario"/></VBox><VBox spacing="6"><Label text="Contraseña" styleClass="field-label"/><PasswordField fx:id="txtPassword" promptText="Tu contraseña" onAction="#iniciarSesion"/></VBox><Button text="Entrar  →" onAction="#iniciarSesion" maxWidth="Infinity" styleClass="primary"/><HBox alignment="CENTER" spacing="3"><Label text="¿Necesitas una cuenta?" styleClass="subtitle"/><Hyperlink text="Regístrate" onAction="#abrirRegistro"/></HBox></VBox>
 </HBox></center>
 <bottom><Label text="ÁMBAR  /  ADMINISTRACIÓN DE USUARIOS" style="-fx-padding: 14 38; -fx-text-fill: #a49789; -fx-font-size: 10px;"/></bottom>
</BorderPane>