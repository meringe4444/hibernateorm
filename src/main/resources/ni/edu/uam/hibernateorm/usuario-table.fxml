<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ni.edu.uam.hibernateorm.controller.UsuarioTableController" prefWidth="1060" prefHeight="640" stylesheets="@ambar.css">
 <top><VBox><HBox alignment="CENTER_LEFT" spacing="13" style="-fx-background-color: #fffefa; -fx-padding: 18 34; -fx-border-color: transparent transparent #e5ddd1 transparent;"><Label text="●" style="-fx-text-fill: #ad5d37; -fx-font-size: 18px;"/><Label text="ÁMBAR" style="-fx-font-size: 17px; -fx-font-weight: bold;"/><Label text="  /  DIRECTORIO" styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblUsuarioLogueado" text="Usuario" styleClass="field-label"/><Button text="Salir" onAction="#cerrarSesion"/></HBox><HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #e9ded0; -fx-padding: 13 34;"><Label text="ESPACIO DE TRABAJO" styleClass="eyebrow"/><Label text=" / " styleClass="subtitle"/><Label text="Personas" styleClass="field-label"/></HBox></VBox></top>
 <center><VBox spacing="18" style="-fx-padding: 30 38;"><HBox alignment="BOTTOM_LEFT" spacing="15"><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="DIRECTORIO" styleClass="eyebrow"/><Label text="Personas y cuentas" styleClass="title"/><Label text="Consulta y administra los perfiles registrados." styleClass="subtitle"/></VBox><Label fx:id="lblTotalUsuarios" text="0 registros" style="-fx-background-color: #e8d9c6; -fx-padding: 8 14; -fx-text-fill: #895437; -fx-font-weight: bold;"/></HBox><HBox spacing="12" alignment="CENTER_LEFT"><TextField fx:id="txtBuscar" promptText="Buscar por nombre, correo o usuario..." HBox.hgrow="ALWAYS"/><Button text="+  Añadir persona" onAction="#nuevoRegistro" styleClass="primary"/></HBox><TableView fx:id="tableUsuario" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colUsuario" text="USUARIO" prefWidth="130"/><TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="145"/><TableColumn fx:id="colApellido" text="APELLIDO" prefWidth="145"/><TableColumn fx:id="colCorreo" text="CORREO ELECTRÓNICO" prefWidth="230"/><TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="175" style="-fx-alignment: CENTER;"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView><Label text="ÁMBAR  /  GESTIÓN DE PERSONAS" style="-fx-font-size: 10px; -fx-text-fill: #a49789;"/></VBox></center>
</BorderPane>