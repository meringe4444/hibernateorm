<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@ambar.css" fx:controller="ni.edu.uam.hibernateorm.controller.RegistroController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefHeight="580.0" prefWidth="760.0">

    <StackPane alignment="CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox styleClass="card" maxWidth="690.0">
            <!-- Cabecera con Banda Oscura -->
            <HBox style="-fx-background-color: #e9ded0; -fx-padding: 20 28;" alignment="CENTER_LEFT" spacing="14.0">
                <StackPane prefWidth="40.0" prefHeight="40.0">
                    <Label text="+"/>
                </StackPane>
                <VBox spacing="2.0">
                    <Label styleClass="title" text="Nueva persona"/>
                    <Label text="Añade los datos para crear una cuenta en Ámbar"/>
                </VBox>
            </HBox>

            <!-- Cuerpo en 2 Columnas -->
            <HBox spacing="28.0">
                <padding>
                    <Insets top="26.0" right="28.0" bottom="26.0" left="28.0"/>
                </padding>

                <!-- Columna Izquierda: Foto de Perfil -->
                <VBox alignment="TOP_CENTER" spacing="12.0" prefWidth="170.0">
                    <Label text="FOTOGRAFÍA"/>
                    <StackPane prefWidth="140.0" prefHeight="140.0">
                        <ImageView fx:id="imageFoto"
                                   fitHeight="132.0"
                                   fitWidth="132.0"
                                   preserveRatio="true"/>
                    </StackPane>
                    <Button text="Subir Imagen"
                            onAction="#seleccionarFoto"
                            maxWidth="Infinity"/>
                    <Label text="Formatos: JPG, JPEG o PNG"
                           wrapText="true"
                           textAlignment="CENTER"/>
                </VBox>

                <!-- Columna Derecha: Datos del Usuario -->
                <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                    <HBox spacing="12.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Nombre"/>
                            <TextField fx:id="txtNombre" promptText="Primer nombre"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Apellido"/>
                            <TextField fx:id="txtApellido" promptText="Primer apellido"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5.0">
                        <Label text="Correo Electrónico"/>
                        <TextField fx:id="txtCorreo" promptText="nombre@correo.com"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Nombre de Usuario"/>
                        <TextField fx:id="txtUsuario" promptText="Usuario único de acceso"/>
                    </VBox>

                    <HBox spacing="12.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Contraseña"/>
                            <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Confirmar"/>
                            <PasswordField fx:id="txtConfirmaPassword" promptText="Repite la contraseña"/>
                        </VBox>
                    </HBox>

                    <Separator/>

                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button text="Volver"
                                onAction="#regresar"
                                prefWidth="115.0"/>
                        <Button styleClass="primary" text="Crear cuenta"
                                onAction="#registrar"
                                prefWidth="155.0"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
