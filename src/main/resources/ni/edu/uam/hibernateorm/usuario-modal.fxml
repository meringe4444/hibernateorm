<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      stylesheets="@ambar.css" fx:controller="ni.edu.uam.hibernateorm.controller.UsuarioModalController"
      prefWidth="520.0">

    <!-- Cabecera del Modal -->
    <HBox style="-fx-background-color: #e9ded0; -fx-padding: 18 26;" alignment="CENTER_LEFT" spacing="12.0">
        <StackPane prefWidth="36.0" prefHeight="36.0">
            <Label text="✎"/>
        </StackPane>
        <VBox spacing="2.0">
            <Label styleClass="title" text="Editar persona"/>
            <Label text="Actualiza los datos de la cuenta"/>
        </VBox>
    </HBox>

    <!-- Contenido -->
    <VBox spacing="16.0">
        <padding>
            <Insets top="22.0" right="26.0" bottom="24.0" left="26.0"/>
        </padding>

        <!-- Zona de Fotografía -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <StackPane prefWidth="76.0" prefHeight="76.0">
                <ImageView fx:id="imageFoto"
                           fitWidth="70.0"
                           fitHeight="70.0"
                           preserveRatio="true"/>
            </StackPane>
            <VBox spacing="6.0" alignment="CENTER_LEFT">
                <Button text="Cambiar Fotografía"
                        onAction="#cambiarFoto"/>
                <Label text="Imágenes compatibles: JPG o PNG"/>
            </VBox>
        </HBox>

        <!-- Formulario -->
        <VBox spacing="12.0">
            <HBox spacing="12.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Nombre"/>
                    <TextField fx:id="txtNombre" promptText="Nombre"/>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Apellido"/>
                    <TextField fx:id="txtApellido" promptText="Apellido"/>
                </VBox>
            </HBox>

            <VBox spacing="5.0">
                <Label text="Correo Electrónico"/>
                <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"/>
            </VBox>

            <HBox spacing="12.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Usuario"/>
                    <TextField fx:id="txtUsuario" promptText="Nombre de usuario"/>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Contraseña"/>
                    <PasswordField fx:id="txtPassword" promptText="Contraseña"/>
                </VBox>
            </HBox>
        </VBox>

        <Separator/>

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button text="Cancelar"
                    onAction="#cancelar"
                    prefWidth="110.0"/>
            <Button styleClass="primary" text="Guardar Cambios"
                    onAction="#guardar"
                    prefWidth="145.0"/>
        </HBox>
    </VBox>
</VBox>
